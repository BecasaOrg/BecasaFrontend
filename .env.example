# URL base de la API del backend (Laravel). Solo se usa en el servidor.
API_URL=https://athleticscholarshipagency.com/api
# Llave PÚBLICA de Mercado Pago (Card Payment Brick).
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Google Analytics 4 (opcional; solo carga si el usuario acepta cookies).
NEXT_PUBLIC_GA_ID=
# Relación campamento del sitio -> id del campamento en el backend (opcional).
# Si no se define, se busca el campamento del backend por ciudad.
# Ejemplo: bucaramanga:3
NEXT_PUBLIC_CAMP_IDS=
